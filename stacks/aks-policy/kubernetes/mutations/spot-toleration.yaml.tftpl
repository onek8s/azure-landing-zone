# Spot chosen by the application (R17, design section 2.3): a pod labelled platform/capacity: spot
# tolerates the spot pools' taint, platform/capacity=spot:NoSchedule; the cluster autoscaler falls back to
# the on-demand pool when Azure has no spot capacity. The zones' classic spot pools carry AKS's own spot taint too, kubernetes.azure.com/scalesetpriority=spot:NoSchedule, which AKS
# puts on every spot pool and cannot be left out - tolerated as well.
apiVersion: mutations.gatekeeper.sh/v1
kind: ModifySet
metadata:
  name: platform-spot-toleration
spec:
  applyTo:
    - groups: [""]
      kinds: ["Pod"]
      versions: ["v1"]
  match:
    scope: Namespaced
    kinds:
      - apiGroups: [""]
        kinds: ["Pod"]
    # Platform namespaces (the add-on also skips kube-system and gatekeeper-system)
    excludedNamespaces: ["kube-system", "gatekeeper-system", "kube-public", "kube-node-lease", "azure-arc", "azure-extensions-usage-system", "aks-istio-system", "flux-system", "external-secrets", "external-dns", "platform-gateway", "infra-observability", "*-gateway", "*-secrets"]
    labelSelector:
      matchLabels:
        platform/capacity: spot
  location: spec.tolerations
  parameters:
    operation: merge
    values:
      fromList:
        - {key: platform/capacity, operator: Equal, value: spot, effect: NoSchedule}
        - {key: kubernetes.azure.com/scalesetpriority, operator: Equal, value: spot, effect: NoSchedule}
