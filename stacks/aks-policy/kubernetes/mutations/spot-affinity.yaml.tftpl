# Spot chosen by the application (R8): a pod labelled platform/capacity: spot prefers spot nodes that
# already exist - the zones' classic spot pools, which AKS labels kubernetes.azure.com/scalesetpriority=spot
# (the cluster autoscaler's priority expander tries the spot pools first for new ones). Only when it states
# no preferred node affinity of its own.
apiVersion: mutations.gatekeeper.sh/v1
kind: Assign
metadata:
  name: platform-spot-affinity
spec:
  applyTo:
    - groups: [""]
      kinds: ["Pod"]
      versions: ["v1"]
  match:
    scope: Namespaced
    kinds:
      - apiGroups: [""]
        kinds: ["Pod"]
    # Platform namespaces (the add-on also skips kube-system and gatekeeper-system)
    excludedNamespaces: ["kube-system", "gatekeeper-system", "kube-public", "kube-node-lease", "azure-arc", "azure-extensions-usage-system", "aks-istio-system", "flux-system", "external-secrets", "external-dns", "platform-gateway", "infra-observability", "*-gateway", "*-secrets"]
    labelSelector:
      matchLabels:
        platform/capacity: spot
  location: spec.affinity.nodeAffinity.preferredDuringSchedulingIgnoredDuringExecution
  parameters:
    pathTests:
      - subPath: spec.affinity.nodeAffinity.preferredDuringSchedulingIgnoredDuringExecution
        condition: MustNotExist
    assign:
      value:
        - weight: 50
          preference:
            matchExpressions:
              - {key: kubernetes.azure.com/scalesetpriority, operator: In, values: ["spot"]}
